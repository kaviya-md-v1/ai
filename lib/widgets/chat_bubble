// lib/widgets/chat_bubble.dart
// Renders a single message bubble in the terminal chat UI.
// User messages: cyan, right-aligned with "> " prefix
// AI messages:   green, left-aligned with typewriter animation

import 'package:flutter/material.dart';
import '../models/chat_message.dart';
import '../theme/app_theme.dart';
import 'typing_text_widget.dart';

class ChatBubble extends StatelessWidget {
  final ChatMessage message;
  final bool animate; // only true for the newest AI message
  final VoidCallback? onTypingComplete;

  const ChatBubble({
    super.key,
    required this.message,
    this.animate = false,
    this.onTypingComplete,
  });

  @override
  Widget build(BuildContext context) {
    final isUser = message.role == MessageRole.user;
    return Padding(
      padding: const EdgeInsets.symmetric(vertical: 6, horizontal: 12),
      child: Column(
        crossAxisAlignment:
            isUser ? CrossAxisAlignment.end : CrossAxisAlignment.start,
        children: [
          // ── Sender label ──────────────────────────────────────────
          Padding(
            padding: const EdgeInsets.only(bottom: 3),
            child: Text(
              isUser ? '[ KAVIYA ]' : '[ CIPHER ]',
              style: AppTheme.terminalTiny.copyWith(
                color: isUser ? AppTheme.neonCyan : AppTheme.neonGreenDim,
                letterSpacing: 2,
              ),
            ),
          ),

          // ── Message bubble ────────────────────────────────────────
          Container(
            constraints: BoxConstraints(
              maxWidth: MediaQuery.of(context).size.width * 0.85,
            ),
            padding: const EdgeInsets.symmetric(horizontal: 14, vertical: 10),
            decoration: BoxDecoration(
              color: isUser
                  ? AppTheme.neonCyan.withOpacity(0.06)
                  : AppTheme.bgCard,
              border: Border.all(
                color: isUser
                    ? AppTheme.neonCyan.withOpacity(0.4)
                    : AppTheme.neonGreen.withOpacity(0.25),
                width: 1,
              ),
              borderRadius: BorderRadius.only(
                topLeft:     const Radius.circular(2),
                topRight:    const Radius.circular(2),
                bottomLeft:  Radius.circular(isUser ? 2 : 0),
                bottomRight: Radius.circular(isUser ? 0 : 2),
              ),
            ),
            child: isUser
                ? _buildUserText()
                : _buildAIText(),
          ),

          // ── Timestamp ─────────────────────────────────────────────
          Padding(
            padding: const EdgeInsets.only(top: 3),
            child: Text(
              _formatTime(message.timestamp),
              style: AppTheme.terminalTiny,
            ),
          ),
        ],
      ),
    );
  }

  Widget _buildUserText() {
    return RichText(
      text: TextSpan(
        style: AppTheme.userBubbleText,
        children: [
          TextSpan(
            text: '> ',
            style: AppTheme.userBubbleText.copyWith(
              color: AppTheme.neonCyan.withOpacity(0.5),
            ),
          ),
          TextSpan(text: message.content),
        ],
      ),
    );
  }

  Widget _buildAIText() {
    if (message.isTyping) {
      // Loading indicator while awaiting API response
      return _LoadingDots();
    }
    if (animate) {
      return TypingTextWidget(
        text: message.content,
        style: AppTheme.terminalMedium,
        onComplete: onTypingComplete,
        charDelayMs: 14,
      );
    }
    // Already-rendered message — display statically
    return Text(message.content, style: AppTheme.terminalMedium);
  }

  String _formatTime(DateTime dt) {
    final h = dt.hour.toString().padLeft(2, '0');
    final m = dt.minute.toString().padLeft(2, '0');
    final s = dt.second.toString().padLeft(2, '0');
    return '$h:$m:$s';
  }
}

// ── Animated loading dots ─────────────────────────────────────────────────────
class _LoadingDots extends StatefulWidget {
  @override
  State<_LoadingDots> createState() => _LoadingDotsState();
}

class _LoadingDotsState extends State<_LoadingDots>
    with SingleTickerProviderStateMixin {
  late AnimationController _ctrl;
  int _dots = 1;

  @override
  void initState() {
    super.initState();
    _ctrl = AnimationController(
      vsync: this,
      duration: const Duration(milliseconds: 500),
    )..addListener(() {
        setState(() => _dots = (_ctrl.value * 3).floor() + 1);
      })
      ..repeat();
  }

  @override
  void dispose() {
    _ctrl.dispose();
    super.dispose();
  }

  @override
  Widget build(BuildContext context) {
    return Text(
      'processing${'.' * _dots}',
      style: AppTheme.terminalSmall.copyWith(color: AppTheme.neonGreenDim),
    );
  }
}
